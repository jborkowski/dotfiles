{
  "lastChangelogVersion": "1.0.1",
  "defaultModel": "gpt-6-luna",
  "defaultTools": [
    "+codemode"
  ],
  "defaultThinkingLevel": "low",
  "packages": [
    "npm:@ff-labs/pi-fff",
    "git:github.com/jborkowski/pi-sec",
    "npm:pi-subagents",
    "git:github.com/jborkowski/px-cli",
    "npm:pi-antigravity",
    "npm:@rahularya01/pi-cursor",
    "npm:@earendil-works/pi-ai",
    "ssh://git@github.com/earendil-works/pi-voice",
    "git:github.com/jborkowski/pi-clm"
  ],
  "showHardwareCursor": false,
  "collapseChangelog": true,
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "treeFilterMode": "default",
  "hideThinkingBlock": true,
  "piSec": {
    "oauthProviders": [],
    "providers": [
      "zai",
      "deepseek",
      "cursor"
    ]
  },
  "theme": "system/system",
  "terminal": {
    "showTerminalProgress": false
  },
  "fullscreenScrollbar": "hidden",
  "steeringMode": "one-at-a-time",
  "followUpMode": "all",
  "modelThinkingLevels": {
    "zai/glm-5.3": "low",
    "zai/glm-5.3-flash": "low",
    "antigravity/gemini-3.8-flash": "medium"
  },
  "compaction": {
    "enabled": false
  },
  "fullscreenExitOutput": "resume-hint",
  "defaultProvider": "openai",
  "tuiMode": "fullscreen"
}
