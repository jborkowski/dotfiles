[core]
	sshCommand = env -u SSH_SK_PROVIDER /opt/jbrew/bin/ssh
[gpg]
	format = ssh
[gpg "ssh"]
	program = /opt/jbrew/bin/ssh-keygen
	allowedSignersFile = ~/.ssh/allowed_signers
[user]
	signingkey = ~/.ssh/id_ecdsa_sk_rk_macbook.pub
[commit]
	gpgsign = false
[tag]
	gpgsign = false
[credential "https://github.com"]
	helper =
	helper = !/opt/jbrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/jbrew/bin/gh auth git-credential
